#!/bin/bash
# 卸载后：按向导选择决定是否删除数据。
# 官方只说明"可在 wizard/uninstall 中收集选择，并在卸载脚本中执行"，未定义 var 是否自动删除，
# 因此只在用户明确选择 delete 时删自己的子目录；共享目录（影片文件）永远不动。
set -u
if [ "${wizard_keep_data:-keep}" = "delete" ]; then
    rm -rf "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/plugins" "$TRIM_PKGVAR/logs" "$TRIM_PKGVAR/run" 2>/dev/null
fi
exit 0
