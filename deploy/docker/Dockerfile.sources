# 源包静态镜像：nginx + 只读源包目录（不含任何 jar/config）
#
# 为什么单独一个镜像：
#   - 源包（config + spider.jar/spider-dex.jar）是**私有/第三方内容**，不能打进
#     公开的 meow-web/apiserver 镜像，也不能进公开仓库；
#   - 源包更新频率和主应用不同，独立镜像/容器可以只换挂载目录，不重启主栈。
#
# 当前用法（OECT）：
#   docker compose -f docker-compose.sources.yml up -d --build
# 源包目录通过 MEOW_SOURCES_DIR 挂到 /usr/share/nginx/html（只读）。
#
# 换主机/端口时，config.*.json 里的 spider/jar 绝对地址要一起改；同机同端口
# 从 systemd 切过来则不用改。

FROM nginx:1.27-alpine

# 覆盖默认站点配置：监听 8080、禁止 SPA fallback、jar 用 java-archive。
COPY nginx.sources.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

# 健康检查直接取统一入口：文件存在且 nginx 能读，才算源包服务可用。
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/config.all.json >/dev/null || exit 1
