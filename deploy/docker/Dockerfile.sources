# 源包静态镜像：nginx + 内置默认源（主爬虫 + Jable + 54 站）+ 可选挂载覆盖
#
# 镜像内置完整默认源，没有挂载时可直接使用；挂载 /mounted-sources 且含
# config.all.json 时，启动脚本会用挂载的完整源包覆盖默认源。
#
# 为什么单独一个镜像：
#   - 源包更新频率和主应用不同，独立镜像/容器可以只换挂载目录，不重启主栈；
#   - 默认源随镜像发布，自定义源包仍由私有目录/挂载提供，不混进主应用镜像。
#
# 当前用法（OECT / 公开）：
#   docker compose -f docker-compose.sources.yml up -d --build
# 源包目录通过 MEOW_SOURCES_DIR 挂到 /mounted-sources（只读）。

FROM nginx:1.27-alpine

# 覆盖默认站点配置：监听 8080、禁止 SPA fallback、jar 用 java-archive。
COPY nginx.sources.conf /etc/nginx/conf.d/default.conf

# 默认源与启动注入：默认源含主爬虫 + Jable + 54 站配置；MEOW_SOURCES_BASE
# 用于生成 config.all.json 里的绝对 jar 地址（默认 http://127.0.0.1:18080）。
COPY default-sources/ /opt/meow-sources/default/
COPY entrypoint.sh /docker-entrypoint.d/40-meow-sources.sh
RUN chmod +x /docker-entrypoint.d/40-meow-sources.sh

EXPOSE 8080

# 健康检查同时校验规范清单与唯一入口：只有 config.all.json 但没有
# source-pack.json 的旧目录视为未规范化，避免"能访问但规则已经分叉"。
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/source-pack.json >/dev/null \
   && wget -qO- http://127.0.0.1:8080/config.all.json >/dev/null || exit 1
