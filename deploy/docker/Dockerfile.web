# 前端镜像：nginx + 静态文件（不含 JVM）
# 后端在独立容器里，见 Dockerfile.apiserver。
#
# 两种构建方式：
#   1) 容器内构建（默认）   docker build -f Dockerfile.web .
#   2) 用宿主已构建的 dist  docker build -f Dockerfile.web --target runtime-dist .
#
# ★ 多阶段构建在**不给 --target 时取最后一个 stage**。所以容器内构建那个 stage
#   必须写在最末——否则 `docker compose build` 会静默走"用宿主 dist"这条路，
#   修改前端源码不生效（实测踩过：Compose 构建出的镜像里少了新页面）。
#
# 为什么保留第 2 种：容器内构建要 corepack 现拉 pnpm（registry.npmjs.org），
# 网络受限时会直接失败。前端产物与 CPU 架构无关，在 x64 上 pnpm build 出来的
# dist 打进 arm64 镜像同样正确，所以允许跳过容器内构建。

# ---------- 容器内构建 ----------
FROM node:22-alpine AS build

WORKDIR /build

# 先只拷清单以复用层缓存。desktop 的 package.json 只用于让 pnpm 识别 workspace 成员。
COPY client/package.json client/pnpm-lock.yaml client/pnpm-workspace.yaml ./
COPY client/apps/web/package.json ./apps/web/
COPY client/apps/desktop/package.json ./apps/desktop/

# lockfile 按完整 workspace 生成，这里只拷了两个成员，不能 --frozen-lockfile。
# CI=true：容器里没有 TTY，pnpm 遇到需要重建 node_modules 时会以
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY 直接中止（实测）。
ENV CI=true
RUN corepack enable && pnpm install --no-frozen-lockfile --prod=false

COPY client/apps/web ./apps/web
RUN pnpm --filter @meow/web build

# ---------- 公共运行层（不含前端文件） ----------
FROM nginx:1.27-alpine AS base

# 启动时 envsubst 渲染模板，替换 ${MEOW_APISERVER}
COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template

ENV MEOW_APISERVER=http://apiserver:9979
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz | grep -q '"ok":true' || exit 1

# ---------- 路线 2：宿主已构建的 dist（需 --target runtime-dist） ----------
FROM base AS runtime-dist
COPY client/apps/web/dist /usr/share/nginx/html

# ---------- 路线 1：容器内构建的产物（默认，必须放最后） ----------
FROM base AS runtime
COPY --from=build /build/apps/web/dist /usr/share/nginx/html
